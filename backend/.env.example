# SecureVault AI - Backend Environment Configuration

# Server Port
PORT=5000

# Environment Mode (development | production | test)
NODE_ENV=development

# MySQL Database URL (Prisma Connection Format)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/securevault_db"

# Allowed Frontend Client Origin for CORS
FRONTEND_URL="http://localhost:3000"

# JWT Authentication Configuration
JWT_SECRET="secure_vault_ai_jwt_secret_change_in_production"
JWT_EXPIRES_IN="7d"
